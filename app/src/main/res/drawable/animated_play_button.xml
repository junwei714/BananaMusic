<?xml version="1.0" encoding="utf-8"?>
<animated-selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item
        android:id="@+id/playing"
        android:drawable="@drawable/ic_pause_circle"
        android:state_checked="true" />
    <item
        android:id="@+id/paused"
        android:drawable="@drawable/ic_play_circle" />
    
    <transition
        android:fromId="@id/paused"
        android:toId="@id/playing"
        android:drawable="@drawable/play_to_pause" />
    
    <transition
        android:fromId="@id/playing"
        android:toId="@id/paused"
        android:drawable="@drawable/pause_to_play" />
</animated-selector> 