<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/colorPrimaryDark" />
            <stroke android:width="1dp" android:color="@color/colorHappy" />
            <corners android:radius="4dp" />
            <padding android:right="12dp" android:left="12dp" />
        </shape>
    </item>
    <item android:gravity="end|center_vertical" android:right="8dp">
        <rotate android:fromDegrees="0" android:toDegrees="90">
            <shape android:shape="line">
                <stroke android:width="1dp" android:color="@color/colorHappy" />
                <size android:width="12dp" />
            </shape>
        </rotate>
    </item>
    <item android:gravity="end|center_vertical" android:right="8dp">
        <rotate android:fromDegrees="180" android:toDegrees="270">
            <shape android:shape="line">
                <stroke android:width="1dp" android:color="@color/colorHappy" />
                <size android:width="12dp" />
            </shape>
        </rotate>
    </item>
</layer-list> 