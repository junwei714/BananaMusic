<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    android:id="@+id/now_playing_root"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/player_background_gradient"
    android:paddingHorizontal="24dp"
    android:paddingTop="16dp"
    android:paddingBottom="32dp">

    <ImageButton
        android:id="@+id/btnMinimize"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:padding="12dp"
        android:src="@drawable/ic_arrow_down"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        android:tint="@color/player_text_primary"/>

    <com.google.android.material.imageview.ShapeableImageView
        android:id="@+id/ivTrackArt"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="32dp"
        android:scaleType="centerCrop"
        app:layout_constraintDimensionRatio="1:1"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/btnMinimize"
        app:layout_constraintWidth_percent="0.9"
        app:shapeAppearanceOverlay="@style/RoundedImageView"
        tools:src="@drawable/default_album_art"/>

    <TextView
        android:id="@+id/tvTrackTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="32dp"
        android:ellipsize="end"
        android:gravity="center"
        android:maxLines="1"
        android:textColor="@color/player_text_primary"
        android:textSize="24sp"
        android:textStyle="bold"
        android:fontFamily="sans-serif-medium"
        app:layout_constraintTop_toBottomOf="@id/ivTrackArt"
        tools:text="Track Title"/>

    <TextView
        android:id="@+id/tvTrackArtist"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:ellipsize="end"
        android:gravity="center"
        android:maxLines="1"
        android:textColor="@color/player_text_secondary"
        android:textSize="18sp"
        app:layout_constraintTop_toBottomOf="@id/tvTrackTitle"
        tools:text="Artist Name"/>

    <TextView
        android:id="@+id/tvAlbum"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:ellipsize="end"
        android:gravity="center"
        android:maxLines="1"
        android:textColor="@color/player_text_secondary"
        android:textSize="16sp"
        app:layout_constraintTop_toBottomOf="@id/tvTrackArtist"
        tools:text="Album Name"/>

    <LinearLayout
        android:id="@+id/timeContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="32dp"
        android:orientation="vertical"
        app:layout_constraintTop_toBottomOf="@id/tvAlbum">

        <SeekBar
            android:id="@+id/seekbarProgress"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            style="@style/PlayerSeekBar"/>

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp">

            <TextView
                android:id="@+id/tvCurrentTime"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/player_text_secondary"
                android:textSize="12sp"
                android:letterSpacing="0.1"
                android:layout_alignParentStart="true"
                tools:text="0:00"/>

            <TextView
                android:id="@+id/tvTotalDuration"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/player_text_secondary"
                android:textSize="12sp"
                android:letterSpacing="0.1"
                android:layout_alignParentEnd="true"
                tools:text="3:45"/>
        </RelativeLayout>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/controlsContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:gravity="center"
        android:orientation="horizontal"
        app:layout_constraintTop_toBottomOf="@id/timeContainer">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnAddToPlaylist"
            style="@style/PlayerControlButton"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginEnd="16dp"
            app:icon="@drawable/ic_playlist_add"
            app:iconSize="32dp"/>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSkipPrevious"
            style="@style/PlayerControlButton"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginEnd="16dp"
            app:icon="@drawable/ic_skip_previous"
            app:iconSize="32dp"/>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnPlayPause"
            style="@style/PlayerControlButton.Primary"
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:layout_marginHorizontal="8dp"
            app:icon="@drawable/ic_play_arrow"/>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSkipNext"
            style="@style/PlayerControlButton"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginStart="16dp"
            app:icon="@drawable/ic_skip_next"
            app:iconSize="32dp"/>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnShare"
            style="@style/PlayerControlButton.Secondary"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginStart="16dp"
            app:icon="@drawable/ic_share"/>
    </LinearLayout>



    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <!-- Main content -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- Add loading progress bar -->
            <ProgressBar
                android:id="@+id/loading_progress_bar"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:visibility="gone" />

            <!-- ... rest of the layout ... -->

        </LinearLayout>
    </FrameLayout>

</androidx.constraintlayout.widget.ConstraintLayout> 