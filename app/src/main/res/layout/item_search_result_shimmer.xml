<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingHorizontal="16dp"
    android:paddingVertical="12dp">

    <View
        android:id="@+id/view_image"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:background="@drawable/shimmer_rounded_background"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent" />

    <View
        android:id="@+id/view_title"
        android:layout_width="0dp"
        android:layout_height="16dp"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="60dp"
        android:background="@drawable/shimmer_rounded_background"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/view_image"
        app:layout_constraintTop_toTopOf="@+id/view_image"
        app:layout_constraintBottom_toTopOf="@+id/view_artist"
        app:layout_constraintVertical_chainStyle="packed" />

    <View
        android:id="@+id/view_artist"
        android:layout_width="0dp"
        android:layout_height="14dp"
        android:layout_marginStart="16dp"
        android:layout_marginTop="8dp"
        android:layout_marginEnd="120dp"
        android:background="@drawable/shimmer_rounded_background"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/view_image"
        app:layout_constraintTop_toBottomOf="@+id/view_title" />

    <View
        android:id="@+id/view_album"
        android:layout_width="0dp"
        android:layout_height="14dp"
        android:layout_marginStart="16dp"
        android:layout_marginTop="4dp"
        android:layout_marginEnd="140dp"
        android:background="@drawable/shimmer_rounded_background"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/view_image"
        app:layout_constraintTop_toBottomOf="@+id/view_artist"
        app:layout_constraintBottom_toBottomOf="@+id/view_image" />

    <View
        android:id="@+id/view_play_button"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:background="@drawable/shimmer_circle_background"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout> 