<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:cardCornerRadius="20dp"
    app:cardElevation="12dp"
    app:cardBackgroundColor="#121212">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="How are you feeling today?"
            android:textColor="#FFFFFF"
            android:textSize="24sp"
            android:textStyle="bold"
            android:textAlignment="center"
            android:layout_marginBottom="24dp" />

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="16dp"
            app:cardElevation="4dp"
            app:strokeColor="#333333"
            app:strokeWidth="1dp"
            android:layout_marginBottom="20dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="4dp">
                
                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:boxBackgroundMode="none"
                    app:hintEnabled="true"
                    app:hintTextColor="#AAAAAA"
                    android:hint="Describe your mood">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/mood_input"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textColor="#FFFFFF"
                        android:textSize="16sp"
                        android:paddingTop="16dp"
                        android:paddingBottom="16dp" />

                </com.google.android.material.textfield.TextInputLayout>
                
                <TextView
                    android:id="@+id/mood_prediction"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="#4CAF50"
                    android:textSize="14sp"
                    android:padding="8dp"
                    android:visibility="gone"
                    tools:text="Did you mean: Happy?"
                    tools:visibility="visible" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Popular moods:"
            android:textColor="#AAAAAA"
            android:textSize="16sp"
            android:layout_marginBottom="12dp" />

        <androidx.gridlayout.widget.GridLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:columnCount="2"
            app:rowCount="2"
            app:alignmentMode="alignMargins"
            app:useDefaultMargins="true">

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_sad"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                app:layout_columnWeight="1"
                app:cardCornerRadius="16dp"
                app:cardElevation="4dp">
                
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_sad"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:text="Sad"
                    android:textAllCaps="false"
                    android:textSize="14sp"
                    app:icon="@drawable/ic_mood_sad"
                    app:iconGravity="textStart"
                    app:iconPadding="8dp"
                    app:cornerRadius="16dp"
                    android:backgroundTint="#42A5F5"
                    android:paddingVertical="16dp"
                    android:insetTop="0dp"
                    android:insetBottom="0dp" />
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_logo"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                app:layout_columnWeight="1"
                app:cardCornerRadius="16dp"
                app:cardElevation="4dp">
                
                <ImageView
                    android:id="@+id/img_logo"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:src="@drawable/banana_music_logo"
                    android:scaleType="centerInside"
                    android:padding="8dp"
                    android:background="#121212" />
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_relaxed"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                app:layout_columnWeight="1"
                app:cardCornerRadius="16dp"
                app:cardElevation="4dp">
                
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_relaxed"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:text="Relaxed"
                    android:textAllCaps="false"
                    android:textSize="14sp"
                    app:icon="@drawable/ic_mood_relaxed"
                    app:iconGravity="textStart"
                    app:iconPadding="8dp"
                    app:cornerRadius="16dp"
                    android:backgroundTint="#9C27B0"
                    android:paddingVertical="16dp"
                    android:insetTop="0dp"
                    android:insetBottom="0dp" />
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_focused"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                app:layout_columnWeight="1"
                app:cardCornerRadius="16dp"
                app:cardElevation="4dp">
                
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_focused"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:text="Focused"
                    android:textAllCaps="false"
                    android:textSize="14sp"
                    app:icon="@drawable/ic_mood_focused"
                    app:iconGravity="textStart"
                    app:iconPadding="8dp"
                    app:cornerRadius="16dp"
                    android:backgroundTint="#FF9800"
                    android:paddingVertical="16dp"
                    android:insetTop="0dp"
                    android:insetBottom="0dp" />
            </com.google.android.material.card.MaterialCardView>

        </androidx.gridlayout.widget.GridLayout>

        <TextView
            android:id="@+id/mood_suggestion_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="We'll find the perfect music for your mood"
            android:textColor="#BBBBBB"
            android:textSize="14sp"
            android:textAlignment="center"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="16dp" />

        <ProgressBar
            android:id="@+id/mood_processing_progress"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_gravity="center"
            android:indeterminate="true"
            android:visibility="gone"
            tools:visibility="visible" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_generate"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Generate Recommendations"
            android:textAllCaps="false"
            android:textSize="16sp"
            app:icon="@drawable/ic_music_note"
            app:iconGravity="textStart"
            app:cornerRadius="24dp"
            android:backgroundTint="#00C853"
            android:paddingVertical="16dp"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="12dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_advanced"
                style="@style/Widget.MaterialComponents.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Advanced Options"
                android:textAllCaps="false"
                android:textColor="#4CAF50"
                app:icon="@drawable/ic_settings"
                app:iconTint="#4CAF50" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_history"
                style="@style/Widget.MaterialComponents.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Mood History"
                android:textAllCaps="false"
                android:textColor="#4CAF50"
                app:icon="@drawable/ic_history"
                app:iconTint="#4CAF50" />
        </LinearLayout>

    </LinearLayout>
</androidx.cardview.widget.CardView> 