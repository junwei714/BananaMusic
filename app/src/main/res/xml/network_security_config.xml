<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- Allow HTTP traffic for image loading -->
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
            <certificates src="user" />
        </trust-anchors>
    </base-config>
    
    <!-- Domain-specific configurations -->
    <domain-config cleartextTrafficPermitted="true">
        <!-- Spotify CDN domains -->
        <domain includeSubdomains="true">scdn.co</domain>
        <domain includeSubdomains="true">spotify.com</domain>
        
        <!-- Deezer CDN domains -->
        <domain includeSubdomains="true">dzcdn.net</domain>
        <domain includeSubdomains="true">deezer.com</domain>
        
        <!-- Other CDNs -->
        <domain includeSubdomains="true">res.cloudinary.com</domain>
        <domain includeSubdomains="true">picsum.photos</domain>
        <domain includeSubdomains="true">i.scdn.co</domain>
    </domain-config>
</network-security-config> 