rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Match the playlists collection
    match /playlists/{playlistId} {
      // Allow read access if user is authenticated
      allow read: if request.auth != null;
      
      // Allow write if user is the creator or a collaborator
      allow write: if request.auth != null && (
        // New playlist being created
        !exists(/databases/$(database)/documents/playlists/$(playlistId)) ||
        // User is the creator
        resource.data.creatorId == request.auth.uid ||
        // User is a collaborator (using array format)
        request.auth.uid in resource.data.collaborators ||
        // Playlist is collaborative
        resource.data.isCollaborative == true
      );

      // Allow access to tracks subcollection within playlists
      match /tracks/{trackId} {
        allow read: if request.auth != null;
        allow write: if request.auth != null && (
          // Allow write if parent playlist allows write
          get(/databases/$(database)/documents/playlists/$(playlistId)).data.creatorId == request.auth.uid ||
          request.auth.uid in get(/databases/$(database)/documents/playlists/$(playlistId)).data.collaborators ||
          get(/databases/$(database)/documents/playlists/$(playlistId)).data.isCollaborative == true
        );
      }
    }
    
    // Match the users collection
    match /users/{userId} {
      // Allow read/write access only to the user's own document
      allow read, write: if request.auth != null && request.auth.uid == userId;
      
      // Allow access to subcollections of the user's document
      match /recently_played/{document=**} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
      
      // Allow access to other subcollections
      match /{subcollection}/{document=**} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }
    
    // Match the tracks collection
    match /tracks/{trackId} {
      // Allow read access if user is authenticated
      allow read: if request.auth != null;
      // Allow write access to any authenticated user
      allow write: if request.auth != null;
    }
  }
} 