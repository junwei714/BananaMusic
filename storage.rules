rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Match profile images path
    match /profile_images/{filename} {
      // Allow read access to anyone who is authenticated
      allow read: if request.auth != null;
      
      // Allow write only if the user is uploading their own profile picture
      allow write: if request.auth != null 
        && request.auth.uid == filename.split('_')[0]
        && request.resource.size < 5 * 1024 * 1024 // 5MB max file size
        && request.resource.contentType.matches('image/.*');
    }
  }
} 